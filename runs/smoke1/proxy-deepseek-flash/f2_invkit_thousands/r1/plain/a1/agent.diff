+# A number may carry thousands separators, e.g. "1,200" or "1,299.50".
+# Accept them only when the digits are grouped correctly (first group 1-3
+# digits, every later group exactly 3) so that junk like "1,2,3" stays an
+# error instead of being silently mangled into 123.
+_GROUPED_NUMBER = re.compile(r"^[+-]?\d{1,3}(?:,\d{3})+(?:\.\d+)?$")
+
 
 class ParseError(ValueError):
     def __init__(self, line_no: int, message: str):
