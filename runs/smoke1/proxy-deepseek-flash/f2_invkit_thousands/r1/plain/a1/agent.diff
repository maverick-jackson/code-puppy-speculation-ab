+def _clean_number(raw: str) -> str:
+    """Strip surrounding whitespace and remove valid thousands separators."""
+    text = raw.strip()
+    if "," in text and _GROUPED_NUMBER.match(text):
+        return text.replace(",", "")
+    return text
+
