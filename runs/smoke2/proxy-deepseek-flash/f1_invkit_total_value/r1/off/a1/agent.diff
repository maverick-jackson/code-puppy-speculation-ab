@@ -47,6 +47,15 @@ class Inventory:
         want = category.strip().lower()
         return [i for i in self._items.values() if i.category.lower() == want]
 
+    def total_value(self, category: Optional[str] = None) -> float:
+        """Total stock value (price * quantity) rounded to 2 decimals.
+
+        With `category`, only items in that category count; categories are
+        matched the same way as `by_category`.
+        """
+        items = self._items.values() if category is None else self.by_category(category)
+        return round(sum(i.value for i in items), 2)
+
     def low_stock(self, threshold: int = 5) -> List[Item]:
         return sorted((i for i in self._items.values() if i.quantity < threshold),
                       key=lambda i: (i.quantity, i.sku))
