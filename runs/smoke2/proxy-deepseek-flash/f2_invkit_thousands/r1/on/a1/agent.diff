+# Numbers may be written with thousands separators, e.g. "1,200" or "1,299.50".
+# A leading sign is allowed so negatives can still be detected and rejected.
+_GROUPED = re.compile(r"^[+-]?\d{1,3}(?:,\d{3})+(?:\.\d+)?$")
+
 
 class ParseError(ValueError):
     def __init__(self, line_no: int, message: str):
