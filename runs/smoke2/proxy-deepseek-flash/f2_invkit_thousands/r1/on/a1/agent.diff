+def _unseparate(raw: str) -> str:
+    """Drop thousands separators from a numeric string, validating grouping."""
+    s = raw.strip()
+    if "," in s:
+        if not _GROUPED.match(s):
+            raise ValueError(f"invalid number: {raw.strip()!r}")
+        s = s.replace(",", "")
+    return s
+
