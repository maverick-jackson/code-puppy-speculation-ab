+def _strip_separators(raw: str) -> str:
+    """Remove thousands separators so numeric text can be converted.
+
+    Only commas that look like thousands separators are dropped (a comma
+    followed by exactly three digits that ends a group). This keeps values
+    such as "1,299.50" or "1,200" convertible without silently mangling
+    non-numeric input, which must still raise.
+    """
+    text = raw.strip()
+    sign = ""
+    if text[:1] in ("+", "-"):
+        sign, text = text[0], text[1:]
+    integer, dot, fraction = text.partition(".")
+    if dot and not fraction.isdigit():
+        return sign + text
+    groups = integer.split(",")
+    if len(groups) > 1 and all(len(g) == 3 and g.isdigit() for g in groups[1:]) and groups[0].isdigit():
+        integer = "".join(groups)
+        return sign + integer + (dot + fraction if dot else "")
+    return sign + text
+
+
 def _to_int(raw: str) -> int:
-    return int(raw.strip() or 0)
+    return int(_strip_separators(raw) or 0)
 
 
 def _to_float(raw: str) -> float:
